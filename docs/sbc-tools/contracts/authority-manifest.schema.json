{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "const": "sidx-schema3-location1"
    },
    "license": {
      "const": "BSD-3-Clause"
    },
    "authority_inputs": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "SBC-00-CONCEPTS.md",
              "SBC-00-ADDENDUM-A.md",
              "SBC-00-ADDENDUM-B.md",
              "SBC-00-ADDENDUM-C.md",
              "SBC-00-ADDENDUM-D.md",
              "TODO-SIDX-00-CONCEPTS.md",
              "TODO-SIDX-06A-CORPUS-AND-LOCATION-PROJECTION.md",
              "SBC-ERRATA.md",
              "SPEC-BEFORE-CODE-CONCEPTS.md"
            ]
          },
          "repository_id": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                },
                "blob_oid": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "blob_oid",
                "sha256"
              ]
            },
            "maxItems": 1
          }
        },
        "required": [
          "role",
          "repository_id",
          "commit",
          "files"
        ]
      },
      "maxItems": 9,
      "allOf": [
        {
          "contains": {
            "properties": {
              "role": {
                "const": "SBC-00-CONCEPTS.md"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "SBC-00-ADDENDUM-A.md"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "SBC-00-ADDENDUM-B.md"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "SBC-00-ADDENDUM-C.md"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "SBC-00-ADDENDUM-D.md"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "TODO-SIDX-00-CONCEPTS.md"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "TODO-SIDX-06A-CORPUS-AND-LOCATION-PROJECTION.md"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "SBC-ERRATA.md"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "SPEC-BEFORE-CODE-CONCEPTS.md"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "producer_inputs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "scan.py",
              "locations.py",
              "suspect.py"
            ]
          },
          "repository_id": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                },
                "blob_oid": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "blob_oid",
                "sha256"
              ]
            },
            "maxItems": 1
          }
        },
        "required": [
          "role",
          "repository_id",
          "commit",
          "files"
        ]
      },
      "maxItems": 3,
      "allOf": [
        {
          "contains": {
            "properties": {
              "role": {
                "const": "scan.py"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "locations.py"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "suspect.py"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "reviewed_patches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "const": "proposed-operational-metadata-correction"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "applies_to": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "AGENTS.md",
                "CLAUDE.md",
                "README.md"
              ]
            }
          }
        },
        "required": [
          "role",
          "sha256",
          "applies_to"
        ]
      },
      "maxItems": 1,
      "minItems": 1
    },
    "payload_schemas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "const": 3
        },
        "locations": {
          "const": 1
        },
        "diagnostics": {
          "const": 3
        }
      },
      "required": [
        "index",
        "locations",
        "diagnostics"
      ]
    },
    "support_inputs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "AGENTS.md",
              "CLAUDE.md",
              "README.md",
              "LICENSE"
            ]
          },
          "repository_id": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                },
                "blob_oid": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "blob_oid",
                "sha256"
              ]
            },
            "maxItems": 1
          }
        },
        "required": [
          "role",
          "repository_id",
          "commit",
          "files"
        ]
      },
      "maxItems": 4,
      "allOf": [
        {
          "contains": {
            "properties": {
              "role": {
                "const": "AGENTS.md"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "CLAUDE.md"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "README.md"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "LICENSE"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "profile",
    "license",
    "authority_inputs",
    "producer_inputs",
    "reviewed_patches",
    "payload_schemas",
    "support_inputs"
  ]
}
