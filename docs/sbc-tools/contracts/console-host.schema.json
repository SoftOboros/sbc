{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SBCT-01 console host binding v1",
  "description": "Approved explicit host binding. Structural validation does not establish approval or path safety.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "source_repositories": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "minProperties": 1
    },
    "authority_repositories": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "config_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^\\\\:\\x00-\\x1f]+(?<!/)$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tracked_branch": {
      "type": "string",
      "minLength": 1
    },
    "profile_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^\\\\:\\x00-\\x1f]+(?<!/)$"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "patch_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^\\\\:\\x00-\\x1f]+(?<!/)$"
    },
    "approved_authority_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_support_sha256": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "AGENTS.md": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "CLAUDE.md": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "README.md": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "AGENTS.md",
        "CLAUDE.md",
        "README.md"
      ]
    },
    "document_families": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^\\\\:\\x00-\\x1f]+(?<!/)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!\\.{1,2}$)[^/\\\\:\\x00-\\x1f]+$"
      }
    },
    "archive_families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "archive": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^\\\\:\\x00-\\x1f]+(?<!/)$"
          },
          "member": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^\\\\:\\x00-\\x1f]+(?<!/)$"
          },
          "family": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[^/\\\\:\\x00-\\x1f]+$"
          }
        },
        "required": [
          "archive",
          "member",
          "family"
        ]
      }
    },
    "evidence_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^\\\\:\\x00-\\x1f]+(?<!/)$"
      }
    }
  },
  "required": [
    "schema_version",
    "repository_id",
    "source_repositories",
    "authority_repositories",
    "config_path",
    "config_sha256",
    "tracked_branch",
    "profile_path",
    "profile_sha256",
    "patch_path",
    "approved_authority_sha256",
    "approved_support_sha256",
    "document_families",
    "archive_families",
    "evidence_paths"
  ]
}
